# ==============================================================================
# R.A.I. — RAINFALL ARTIFICIAL INTELLIGENCE ENVIRONMENT CONFIGURATION
# ==============================================================================

# Client-Safe Frontend Variables (VITE_*)
VITE_APP_ENV=development
VITE_APP_TITLE="R.A.I. — Rainfall Artificial Intelligence Platform"
VITE_APP_VERSION="1.0.0-sih-prod"
VITE_API_BASE_URL=/api/v1

# ------------------------------------------------------------------------------
# BACKEND-ONLY CONFIGURATION (Never exposed to browser client)
# ------------------------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173,https://rainain.in
ENABLE_DEBUG_LOGS=true

# OTP Delivery Provider Options: AUTO | API_EMAIL | SMTP | SMS | DEVELOPMENT_SIMULATOR
OTP_PROVIDER=AUTO

# Transactional Email API Configuration
TRANSACTIONAL_EMAIL_PROVIDER=MAILGUN
TRANSACTIONAL_EMAIL_API_KEY=your_email_api_key_here
TRANSACTIONAL_EMAIL_DOMAIN=auth.rainain.in
TRANSACTIONAL_EMAIL_FROM="R.A.I. Security <auth@rainain.in>"

# SMTP Gateway Configuration
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@rai.ai
SMTP_PASSWORD=your_smtp_password_here
SMTP_FROM="R.A.I. Security <auth@rai.ai>"

# SMS Gateway Configuration
SMS_PROVIDER=TWILIO
SMS_PROVIDER_API_KEY=your_sms_api_key_here
SMS_SENDER_ID=RAIAUTH

# ------------------------------------------------------------------------------
# SUPABASE MANAGED POSTGRESQL CONFIGURATION (Backend-Only)
# ------------------------------------------------------------------------------
# Supabase Project URL (e.g. https://your-project-ref.supabase.co)
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Service Role Key (Required for backend PostgreSQL access)
# NEVER expose this key to frontend or in VITE_* variables
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Direct PostgreSQL Connection URL (Optional / Migration Tooling)
DATABASE_URL=postgresql://postgres.your-project-ref:your_password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

