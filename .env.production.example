# ==============================================================================
# R.A.I. — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# WARNING: NEVER commit the filled .env.production file to version control.
# Values below are template place-holders to be supplied via secure environment injection.

# ------------------------------------------------------------------------------
# 1. CLIENT-SAFE FRONTEND VARIABLES (Built into SPA bundle by Vite)
# ------------------------------------------------------------------------------
VITE_APP_ENV=production
VITE_APP_TITLE="R.A.I. — Rainfall Artificial Intelligence Platform"
VITE_APP_VERSION="1.0.0-sih-prod"
VITE_API_BASE_URL=https://api.rainain.in

# ------------------------------------------------------------------------------
# 2. BACKEND API & INFERENCE SERVICE CONFIGURATION (Backend-Only)
# ------------------------------------------------------------------------------
APP_ENV=production
PORT=8000
ALLOWED_ORIGINS=https://rainain.in,https://www.rainain.in
SESSION_SECRET_KEY=generate_a_secure_256_bit_random_hex_key_here
ENABLE_DEBUG_LOGS=false

# ------------------------------------------------------------------------------
# 3. OTP DELIVERY PROVIDER (Backend-Only - Choose SMTP, API_EMAIL, or SMS)
# ------------------------------------------------------------------------------
OTP_PROVIDER=API_EMAIL

# Transactional Email API (e.g. Mailgun / SendGrid / Postmark / AWS SES)
TRANSACTIONAL_EMAIL_PROVIDER=MAILGUN
TRANSACTIONAL_EMAIL_API_KEY=your_production_email_api_key_here
TRANSACTIONAL_EMAIL_DOMAIN=auth.rainain.in
TRANSACTIONAL_EMAIL_FROM="R.A.I. Security <auth@rainain.in>"

# Standard SMTP Gateway (if using SMTP instead of HTTP API)
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@auth.rainain.in
SMTP_PASSWORD=your_production_smtp_password_here
SMTP_FROM="R.A.I. Security <auth@rainain.in>"

# SMS Gateway (e.g. Twilio / Gupshup / AWS SNS)
SMS_PROVIDER=TWILIO
SMS_PROVIDER_API_KEY=your_production_sms_api_key_here
SMS_SENDER_ID=RAIAUTH
